<?php /** @var $block \DevScripts\OrderStatusColor\Block\Adminhtml\Order\Grid\DynamicCss */ ?>
<?php if ($block->isEnabled()): ?>
    <?php $colors = $block->getStatusColors(); ?>
    
    <script type="text/javascript">
        // Create a global JS map for custom labels and colors
        window.orderStatusColorMap = <?= json_encode(array_column($colors, null, 'status')) ?>;
    </script>

    <style type="text/css">
        /* Base styles for status badges */
        .order-status-badge {
            padding: 4px 10px;
            border-radius: 3px;
            font-weight: 700;
            display: inline-block;
            min-width: 90px;
            text-align: center;
            text-transform: uppercase;
            font-size: 11px;
            line-height: 1.4;
            border: 1px solid transparent;
        }

        <?php foreach ($colors as $row): ?>
            <?php $class = strtolower($row['status']); ?>
            /* Dynamic colors for each status */
            .status-<?= $class ?> {
                background-color: <?= $row['bg_color'] ?>;
                color: <?= $row['text_color'] ?>;
                border-color: <?= $row['text_color'] ?>;
            }
        <?php endforeach; ?>
    </style>
<?php endif; ?>