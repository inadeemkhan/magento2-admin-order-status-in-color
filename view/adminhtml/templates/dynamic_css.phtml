<?php
/**
 * @var \DevScripts\OrderStatusColor\Block\Adminhtml\Order\Grid\DynamicCss $block
 */
?>
<?php if ($block->isEnabled()): ?>
    <style>
        .order-status-badge {
            padding: 4px 10px;
            border-radius: 3px;
            font-weight: 700;
            display: inline-block;
            min-width: 90px;
            text-align: center;
            text-transform: uppercase;
            font-size: 11px;
            line-height: 1.4;
            border: 1px solid transparent;
        }

        <?php foreach ($block->getStatusColors() as $row): ?>
            <?php
            $statusClass = strtolower((string)($row['status'] ?? ''));
            $bgColor = (string)($row['bg_color'] ?? '');
            $textColor = (string)($row['text_color'] ?? '');
            ?>

            .status-<?= $block->escapeHtmlAttr($statusClass) ?> {
                background-color: <?= $block->escapeHtmlAttr($bgColor) ?>;
                color: <?= $block->escapeHtmlAttr($textColor) ?>;
                border-color: <?= $block->escapeHtmlAttr($textColor) ?>;
            }
        <?php endforeach; ?>
    </style>
<?php endif; ?>